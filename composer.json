{
  "name": "aymudo/aymudo-php-sdk",
  "description": "Official PHP 8.2+ SDK for the Aymudo API.",
  "type": "library",
  "license": "MIT",
  "require": { "php": "^8.2", "ext-curl": "*", "ext-json": "*" },
  "require-dev": { "phpunit/phpunit": "^11.0" },
  "autoload": { "psr-4": { "Aymudo\\": "src/" } },
  "autoload-dev": { "psr-4": { "Aymudo\\Tests\\": "tests/" } },
  "scripts": { "test": "phpunit --colors=always", "lint": "php -l src/Client.php && php -l src/Http/CurlTransport.php" },
  "config": { "sort-packages": true }
}
